name: CI
on:
  push: { branches: [main, genspark_ai_developer] }
  pull_request: { branches: [main] }
concurrency: { group: ci-${{ github.ref }}, cancel-in-progress: true }
permissions: { contents: read }
env:
  DATABASE_URL: postgresql://postgres:postgres@localhost:5432/scam_ci
  APP_DATABASE_URL: postgresql://postgres:postgres@localhost:5432/scam_ci
  AUTH_SECRET: ci-only-secret-0123456789abcdef0123456789abcdef
  ROOT_DOMAIN: localhost
  DEFAULT_TENANT_SLUG: demo
  NEXT_TELEMETRY_DISABLED: 1
jobs:
  quality:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    services:
      postgres:
        image: postgres:17
        env: { POSTGRES_PASSWORD: postgres, POSTGRES_DB: scam_ci }
        ports: ["5432:5432"]
        options: --health-cmd "pg_isready -U postgres" --health-interval 5s --health-timeout 5s --health-retries 10
    defaults: { run: { working-directory: app } }
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: pnpm/action-setup@v4
        with: { version: 10 }
      - uses: actions/setup-node@v4
        with: { node-version: 22, cache: pnpm, cache-dependency-path: app/pnpm-lock.yaml }
      - run: pnpm install --frozen-lockfile
      - name: Secrets scan
        uses: gitleaks/gitleaks-action@v2
        env: { GITHUB_TOKEN: "${{ secrets.GITHUB_TOKEN }}" }
      - run: pnpm audit --prod --audit-level=high
        continue-on-error: true
      - run: pnpm db:generate
      - run: pnpm db:deploy
      - run: pnpm tsx scripts/gen-rls.ts
      - run: pnpm db:seed
      - run: pnpm lint
      - run: pnpm typecheck
      - run: pnpm test
      - run: pnpm build
      - run: pnpm exec playwright install --with-deps chromium
      - run: pnpm e2e
        env: { CI: true }
      - uses: actions/upload-artifact@v4
        if: failure()
        with: { name: playwright-report, path: app/playwright-report, retention-days: 7 }
