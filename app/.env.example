# ---- Database (docs/30-architecture/01-MULTI-TENANCY.md) ----
# Runtime connection: app_user has NO BYPASSRLS → RLS is enforced on every query.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/scam2027?schema=public"
# Migrations/seed/platform ops: owner role (bypasses RLS). Never used by request handlers.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scam2027?schema=public"

# ---- Auth.js ----
AUTH_SECRET="change-me-32-bytes-min-generate-with-openssl-rand-base64-32"
# AUTH_URL must stay UNSET: redirects are derived per request from the tenant host (multi-tenant subdomains,
# preview tunnels). Setting it pins every post-login redirect to one origin.
# AUTH_URL=
AUTH_TRUST_HOST=true

# ---- Tenant resolution ----
# Root domain: <slug>.<ROOT_DOMAIN> → tenant slug. Custom domains are matched from TenantDomain table.
ROOT_DOMAIN="localhost"
# Fallback tenant slug for localhost/dev/preview hosts that match no <slug>.ROOT_DOMAIN or customDomain.
# Leave EMPTY in production (a warning is logged if it is used there).
DEFAULT_TENANT_SLUG="demo"

# ---- App ----
NODE_ENV="development"
LOG_LEVEL="info"
APP_ENCRYPTION_KEY="base64:change-me-32-bytes-for-aes-256-gcm"

# ---- Files (P1-06) ----
# local (default) stores under STORAGE_LOCAL_ROOT (outside public/); s3 needs the S3_* block (MinIO/R2 work via S3_ENDPOINT).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_BYTES=52428800
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
